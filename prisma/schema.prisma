// DATABASE_URL points at Postgres (Neon) — same database for local dev and
// production, so data is consistent regardless of where it's accessed from.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  dueDate     DateTime?
  priority    String    @default("medium") // "low" | "medium" | "high"
  category    String    @default("weekly") // "weekly" | "monthly"
  completed   Boolean   @default(false)
  // Set once, the first time dueDate passes while still incomplete — gates
  // the one-time focus-point penalty so it never fires twice for one task.
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ScheduleEvent {
  id        String   @id @default(cuid())
  title     String
  date      DateTime // anchor date for one-off events; ignored (but still set) for recurring ones
  startTime String   // "HH:mm"
  endTime   String   // "HH:mm"
  recurring String   @default("none") // "none" | "daily" | "weekly"
  weekday   Int? // 0-6 when recurring = "weekly"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudySession {
  id              String    @id @default(cuid())
  subject         String
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int? // set once the session is stopped
  notes           String?
  createdAt       DateTime  @default(now())
}

model Habit {
  id        String     @id @default(cuid())
  name      String
  frequency String     @default("daily") // "daily" | "weekly"
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitId   String
  date      DateTime
  completed Boolean  @default(true)

  @@unique([habitId, date])
}

model JournalEntry {
  id        String   @id @default(cuid())
  date      DateTime
  content   String
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          String      @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime?
  status      String      @default("active") // "active" | "completed" | "abandoned"
  // Once finalized, the goal can't be deleted or have milestones added/removed
  // until targetDate passes — a commitment device, only settable on goals
  // that have a targetDate.
  locked      Boolean     @default(false)
  // Evidence submitted to mark the goal complete: a link, or an uploaded
  // image as a data: URI (same convention as MediaItem.imageUrl).
  proofUrl    String?
  // Set once, the first time targetDate passes while status is still
  // "active" — gates the one-time focus-point penalty (status also flips to
  // "abandoned" at that point) so it never fires twice for one goal.
  failedAt    DateTime?
  createdAt   DateTime    @default(now())
  milestones  Milestone[]
}

model Milestone {
  id        String  @id @default(cuid())
  goal      Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    String
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)
}

model MediaItem {
  id          String    @id @default(cuid())
  category    String // "movie" | "webseries" | "game"
  title       String
  status      String    @default("upcoming") // "upcoming" | "completed"
  completedAt DateTime?
  imageUrl    String? // poster/cover image: remote URL or data: URI
  notes       String?
  createdAt   DateTime  @default(now())
}

// Once an achievement id lands here it stays forever, even if the stats
// that originally triggered it later drop back below the threshold.
model UnlockedAchievement {
  id         String   @id // achievement id from src/lib/achievements.ts
  unlockedAt DateTime @default(now())
}

// One row per minigame/puzzle/riddle id (see src/lib/games.ts). Minigames are
// replayable — completionsToday/lastCompletionDate cap how many awards a
// single game can earn per day so focus-time can't be farmed by replaying
// the same game. Puzzles/riddles are one-shot: `solved` gates the reward to
// the first correct answer only.
model GameRecord {
  id                 String   @id @default(cuid())
  game               String   @unique
  kind               String // "minigame" | "puzzle" | "riddle"
  timesCompleted     Int      @default(0)
  bestScore          Int?
  solved             Boolean  @default(false)
  completionsToday   Int      @default(0)
  lastCompletionDate String? // "YYYY-MM-DD", local to the server
  updatedAt          DateTime @updatedAt
}

// One row per finished minigame session, win or not — separate from
// GamePlay (which only logs *rewarded* plays). Backs "games played" /
// "games won" stats without being limited by the daily/weekly reward caps.
model GameAttempt {
  id       String   @id @default(cuid())
  game     String
  result   String // "won" | "lost" | "draw"
  playedAt DateTime @default(now())

  @@index([game, playedAt])
  @@index([playedAt])
}

// One row per rewarded minigame play (kind = "minigame" only — puzzles and
// riddles stay one-shot via GameRecord.solved). Backs the per-difficulty
// daily caps and the combined weekly cap: rows are only written when a play
// actually earns a reward, so counting rows *is* counting chances used.
model GamePlay {
  id             String   @id @default(cuid())
  game           String
  difficulty     String // "easy" | "medium" | "hard"
  awardedMinutes Int
  bonusPoints    Int      @default(0)
  playedAt       DateTime @default(now())

  @@index([game, difficulty, playedAt])
  @@index([playedAt])
}

// Ledger of focus-point bonuses/penalties that are NOT real logged study
// time — minigame/puzzle/riddle rewards, and task/goal/habit failure
// penalties. Focus Points = sum(StudySession.durationMinutes) + sum(amount)
// here, so this can move the Focus Points total up or down without ever
// touching the StudySession history that the Focus stats/streak read from.
model FocusPointAdjustment {
  id        String   @id @default(cuid())
  amount    Int // positive = bonus, negative = penalty
  reason    String // e.g. "minigame:chess:hard", "task-failed:<id>", "habit-missed:<id>:<day>"
  createdAt DateTime @default(now())

  @@index([reason])
}
